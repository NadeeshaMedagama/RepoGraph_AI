# ═══════════════════════════════════════════════════════════════════════════════
# RepoGraph AI - Environment Configuration Example
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and update with your credentials
#
# cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────
# Azure OpenAI Configuration (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────────
# Get these from Azure Portal > Your OpenAI Resource > Keys and Endpoint
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# Embeddings Configuration
# Must match your deployment name exactly as shown in Azure AI Studio
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_EMBEDDINGS_VERSION=2024-02-01

# Chat/Completion Configuration
# Must match your deployment name exactly as shown in Azure AI Studio
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ─────────────────────────────────────────────────────────────────────────────────
# Pinecone Configuration (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────────
# Get your API key from Pinecone Console > API Keys
PINECONE_API_KEY=your_pinecone_api_key_here

# Index name - will be created if it doesn't exist
PINECONE_INDEX_NAME=repograph-ai

# Embedding dimension - MUST match your embedding model
# 1536 for text-embedding-ada-002 or text-embedding-3-small
# 3072 for text-embedding-3-large
PINECONE_DIMENSION=1536

# Serverless configuration
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Namespace configuration
PINECONE_USE_NAMESPACES=true
PINECONE_NAMESPACE=documents

# ─────────────────────────────────────────────────────────────────────────────────
# Google Vision API Configuration (OPTIONAL)
# ─────────────────────────────────────────────────────────────────────────────────
# Get from Google Cloud Console > APIs & Services > Credentials
# Only needed for image/diagram analysis
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# Alternative: Path to service account JSON
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-vision.json

# ─────────────────────────────────────────────────────────────────────────────────
# GitHub Configuration (OPTIONAL)
# ─────────────────────────────────────────────────────────────────────────────────
# Personal access token for higher rate limits
GITHUB_TOKEN=ghp_your_github_token_here

# Default repository to process
GITHUB_REPO_URL=

# ─────────────────────────────────────────────────────────────────────────────────
# Data Processing Configuration
# ─────────────────────────────────────────────────────────────────────────────────
# Directory containing files to process
DATA_DIRECTORY=./data/diagrams

# Enable/disable local file processing
PROCESS_LOCAL_FILES=true

# Chunking configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ─────────────────────────────────────────────────────────────────────────────────
# Processing Control
# ─────────────────────────────────────────────────────────────────────────────────
# Skip files that are already indexed (recommended)
SKIP_EXISTING_DOCUMENTS=true

# Force reprocessing of all documents
FORCE_REPROCESS=false

# Maximum concurrent processing tasks
MAX_CONCURRENT_TASKS=5

# ─────────────────────────────────────────────────────────────────────────────────
# URL Processing (OPTIONAL)
# ─────────────────────────────────────────────────────────────────────────────────
PROCESS_URLS=false
URL_LIST=
URL_FILE_PATH=
URL_TIMEOUT=30

# ─────────────────────────────────────────────────────────────────────────────────
# Logging Configuration
# ─────────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/repograph.log

# ─────────────────────────────────────────────────────────────────────────────────
# API Server Configuration
# ─────────────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
